# Bu dosyayı ".env" adıyla kopyalayıp değerleri değiştirin:  cp .env.example .env
# .env depoya GİRMEZ (.gitignore'da), .env.example girer.
# Değer verilmezse docker-compose.yml içindeki demo varsayılanları kullanılır.

# ---- İlk kurulumda oluşturulan Sistem Yöneticisi ----
SYSADMIN_EMAIL=sysadmin@stajdesk.local
SYSADMIN_PASSWORD=StajDesk!2026

# ---- Demo verisi (mağazalar, kullanıcılar, cihazlar, talepler) ----
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo!2026pass

# ---- PostgreSQL ----
POSTGRES_DB=stajdesk
POSTGRES_USER=stajdesk
POSTGRES_PASSWORD=stajdesk_dev
# Bilgisayarınızda 5432 portunu başka bir PostgreSQL kullanıyorsa değiştirin (ör. 5433)
POSTGRES_PORT=5432

# ---- RabbitMQ ----
RABBITMQ_USER=stajdesk
RABBITMQ_PASSWORD=stajdesk_dev

# ---- OAuth 2.0 ----
# Servisten servise erişim örneği: client_id=stajdesk-reporting (client_credentials)
REPORTING_CLIENT_SECRET=Reporting!Dev2026
# Tarayıcıdan erişilen adresler (token issuer ve e-postadaki bağlantılar bunları kullanır)
PUBLIC_WEB_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:5080

# ---- Dışarıya açılan portlar ----
WEB_PORT=8080
API_PORT=5080
SEQ_UI_PORT=5380
MAILPIT_UI_PORT=8025

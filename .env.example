# Bu dosyayı ".env" adıyla kopyalayıp değerleri değiştiriniz:  cp .env.example .env
# .env depoya GİRMEZ (.gitignore'da), .env.example girer.
# Değer verilmezse docker-compose.yml içindeki geliştirme varsayılanları kullanılır.

# PostgreSQL
POSTGRES_DB=stajdesk
POSTGRES_USER=stajdesk
POSTGRES_PASSWORD=stajdesk_dev
# Bilgisayarınızda zaten bir PostgreSQL 5432 portunu kullanıyorsa değiştiriniz
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=stajdesk
RABBITMQ_PASSWORD=stajdesk_dev

# JWT imzalama anahtarı (en az 32 karakter, gerçek ortamda mutlaka değiştiriniz)
JWT_KEY=dev-only-key-change-me-0123456789-abcdefghijkl

# Açılışta oluşturulacak yönetici hesabı
ADMIN_EMAIL=admin@stajdesk.local
ADMIN_PASSWORD=Admin123!

# Demo verisi (örnek kullanıcılar, cihazlar ve talepler)
SEED_DEMO_DATA=true
DEMO_PASSWORD=Demo123!

# Dışarıya açılan portlar
WEB_PORT=8080
API_PORT=5080
SEQ_UI_PORT=5380

{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "http://localhost:5080",
    "Audience": "stajdesk-api",
    "ExpiresMinutes": 15,
    "KeysDirectory": "keys"
  },
  "OAuth": {
    "WebUrl": "http://localhost:8080",
    "WebRedirectUris": "http://localhost:8080/auth/callback",
    "RefreshTokenDays": 14,
    "SecureCookies": false,
    "ReportingClientSecret": ""
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "",
    "Password": "",
    "VirtualHost": "/"
  },
  "LoginRateLimit": {
    "MaxFailedAttempts": 5,
    "WindowSeconds": 300
  },
  "Seq": {
    "ServerUrl": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Seed": {
    "DemoData": false,
    "AdminEmail": "",
    "AdminPassword": "",
    "DemoPassword": ""
  }
}
